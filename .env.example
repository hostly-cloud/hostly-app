# Copiar a `.env.local` y rellenar con el objeto firebaseConfig de
# Firebase Console -> Project settings -> Your apps -> SDK setup (Config).
#
# En desarrollo, si dejas NEXT_PUBLIC_FIREBASE_API_KEY vacio, la app arranca
# con un stub local (`hostly-dev-local`) y `isFirebaseConfigured` sera false
# (login/dashboard no fingen conexion real).
#
# No commitees `.env.local` ni service accounts / PRIVATE_KEY.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push de Firebase. Si el proyecto usa la clave VAPID predeterminada, puede
# quedar vacio; para una clave propia, copiar la clave publica desde Firebase.
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Origenes publicos canonicos. Produccion usa https://hostlyapp.app.
# NEXT_PUBLIC_SITE_URL se usa para metadatos; NEXT_PUBLIC_APP_URL para enlaces
# enviados por el servidor (por ejemplo, invitaciones).
NEXT_PUBLIC_SITE_URL=https://hostlyapp.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alertas operativas externas (server-side).
# Push usa Firebase Cloud Messaging con la misma cuenta de servicio Firebase.
# Email usa Resend y permanece desactivado de forma segura hasta configurar
# clave y remitente verificado. WhatsApp/SMS no se habilitan aun.
# HOSTLY_RESEND_API_KEY=re_...
# HOSTLY_ALERT_EMAIL_FROM=Hostly <alerts@hostlyapp.app>
# Vercel Cron envia este secreto como Authorization: Bearer <secret> si existe.
# Si no esta provisionado, la ruta solo admite la llamada de cron de Vercel y
# mantiene un lease global para evitar ejecuciones repetidas.
# CRON_SECRET=

# Marketing / medicion (landing publica). Por defecto queda desactivado.
# Activalo solo cuando GA4/Meta esten configurados y el banner de consentimiento
# este desplegado. No pongas aqui secretos: estos identificadores son publicos.
NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5J5FT0YCL5
NEXT_PUBLIC_META_PIXEL_ID=

# OpenAI / Menu Import V2 shadow (server-side only; opcional)
# OPENAI_API_KEY=
# HOSTLY_AI_IMPORT_V2_SHADOW=false
# Recuperacion conservadora de productos en fotos: requiere SHADOW=true y solo
# anade items de vision que ya han superado la validacion anti-invencion OCR.
# HOSTLY_AI_IMPORT_V2_PHOTO_RECOVERY=false
# HOSTLY_AI_IMPORT_V2_API=chat_completions
# HOSTLY_AI_IMPORT_V2_MODEL=gpt-4o-mini
# Imagenes de producto: Vercel AI Gateway usa OIDC automaticamente en Vercel.
# Modelo economico por defecto; solo sobrescribir con un id vigente del Gateway.
# HOSTLY_AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
#
# Evaluacion moderna sin cambiar produccion:
# npm run eval:menu-import:modern
# Usa Responses API + gpt-5.6-luna por defecto. Puedes sobrescribir el modelo
# con HOSTLY_AI_IMPORT_V2_MODEL para comparar Luna, Terra u otro modelo.

# Catalogo real de imagenes (server-side). Open Food Facts pide identificar la
# aplicacion y un email de contacto en User-Agent. No contiene secretos.
# HOSTLY_OPENFOODFACTS_USER_AGENT=Hostly/1.0 (contact@hostlyapp.app)

# Suscripciones SaaS Hostly (Stripe, server-side only).
# Seguridad: el sistema queda desactivado aunque existan claves hasta poner
# HOSTLY_STRIPE_BILLING_ENABLED=true. Configurar los 6 Price IDs recurrentes en
# Stripe antes de activar y apuntar el webhook a /api/subscription/webhook.
HOSTLY_STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_...
# STRIPE_HOSTLY_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# HOSTLY_STRIPE_PRICE_BASIC_MONTHLY=price_...
# HOSTLY_STRIPE_PRICE_BASIC_ANNUAL=price_...
# HOSTLY_STRIPE_PRICE_PRO_MONTHLY=price_...
# HOSTLY_STRIPE_PRICE_PRO_ANNUAL=price_...
# HOSTLY_STRIPE_PRICE_ULTRA_MONTHLY=price_...
# HOSTLY_STRIPE_PRICE_ULTRA_ANNUAL=price_...
