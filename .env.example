# Copiar a `.env.local` y rellenar con el objeto firebaseConfig de
# Firebase Console -> Project settings -> Your apps -> SDK setup (Config).
#
# En desarrollo, si dejas NEXT_PUBLIC_FIREBASE_API_KEY vacio, la app arranca
# con un stub local (`hostly-dev-local`) y `isFirebaseConfigured` sera false
# (login/dashboard no fingen conexion real).
#
# No commitees `.env.local` ni service accounts / PRIVATE_KEY.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Origenes publicos canonicos. Produccion usa https://hostlyapp.app.
# NEXT_PUBLIC_SITE_URL se usa para metadatos; NEXT_PUBLIC_APP_URL para enlaces
# enviados por el servidor (por ejemplo, invitaciones).
NEXT_PUBLIC_SITE_URL=https://hostlyapp.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing / medicion (landing publica). Por defecto queda desactivado.
# Activalo solo cuando GA4/Meta esten configurados y el banner de consentimiento
# este desplegado. No pongas aqui secretos: estos identificadores son publicos.
NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5J5FT0YCL5
NEXT_PUBLIC_META_PIXEL_ID=

# OpenAI / Menu Import V2 shadow e imagenes (server-side only; opcional)
# OPENAI_API_KEY=
# HOSTLY_AI_IMPORT_V2_SHADOW=false
# Recuperacion conservadora de productos en fotos: requiere SHADOW=true y solo
# anade items de vision que ya han superado la validacion anti-invencion OCR.
# HOSTLY_AI_IMPORT_V2_PHOTO_RECOVERY=false
# HOSTLY_AI_IMPORT_V2_API=chat_completions
# HOSTLY_AI_IMPORT_V2_MODEL=gpt-4o-mini
# HOSTLY_OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
# HOSTLY_OPENAI_IMAGE_QUALITY=low
#
# Evaluacion moderna sin cambiar produccion:
# npm run eval:menu-import:modern
# Usa Responses API + gpt-5.6-luna por defecto. Puedes sobrescribir el modelo
# con HOSTLY_AI_IMPORT_V2_MODEL para comparar Luna, Terra u otro modelo.

# Catalogo real de imagenes (server-side). Open Food Facts pide identificar la
# aplicacion y un email de contacto en User-Agent. No contiene secretos.
# HOSTLY_OPENFOODFACTS_USER_AGENT=Hostly/1.0 (contact@hostlyapp.app)
