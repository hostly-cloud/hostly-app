rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userProfileData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
            : null
        );
    }

    function userRestaurantId() {
      let profile = userProfileData();
      return profile != null && profile.restaurantId is string
        ? profile.restaurantId
        : null;
    }

    // Rol crudo del perfil (`users/{uid}` o `usuarios/{uid}`).
    function userRole() {
      let profile = userProfileData();
      return profile != null && profile.role is string
        ? profile.role.lower()
        : '';
    }

    // Matriz alineada con lib/auth/hostly-capabilities.ts (Fase 5 / 5B).
    // Sin role en perfil → viewer (denegar elevación por defecto).
    // staff Firebase → manager (legacy operacional).
    function normalizedRole() {
      let role = userRole();
      return role == 'owner' || role == 'propietario' ? 'owner'
        : role == 'admin' || role == 'administrator' ? 'admin'
        : role == 'manager' || role == 'gerente' ? 'manager'
        : role == 'waiter' || role == 'camarero' || role == 'camarera' || role == 'staff_tpv' ? 'waiter'
        : role == 'kitchen' || role == 'cocina' || role == 'cook' ? 'kitchen'
        : role == 'viewer' || role == 'readonly' || role == 'read_only' ? 'viewer'
        : role == 'staff' ? 'manager'
        : 'viewer';
    }

    function isOwnerOrAdmin() {
      let role = normalizedRole();
      return role == 'owner' || role == 'admin';
    }

    function isManagerOrAbove() {
      let role = normalizedRole();
      return role == 'owner' || role == 'admin' || role == 'manager';
    }

    function hasOperationalRole(roleName) {
      return normalizedRole() == roleName;
    }

    function canManageInventory() {
      return isManagerOrAbove();
    }

    function canManagePurchases() {
      return isManagerOrAbove();
    }

    function canManageSupplierInvoices() {
      return isManagerOrAbove();
    }

    // Fase 5C: activo en payments create.
    function canChargeTpv() {
      let role = normalizedRole();
      return isOwnerOrAdmin() || role == 'manager' || role == 'waiter';
    }

    // Fase 5C: activo en orderItems update cuando isCancellingOrderLine().
    function canCancelTpvLine() {
      let role = normalizedRole();
      return isOwnerOrAdmin() || role == 'manager' || role == 'waiter';
    }

    // Fase 5D: activo en payments update cuando isRefundWrite() (tpv.refund → manager+).
    function canRefundTpv() {
      return isManagerOrAbove();
    }

    function isCancelledLineStatus(status) {
      return status is string
        && (
          status.lower() == 'cancelled'
          || status.lower() == 'canceled'
          || status.lower() == 'cancelado'
        );
    }

    function orderItemLineQuantity(data) {
      return data.quantity is number
        ? data.quantity
        : (data.qty is number ? data.qty : null);
    }

    // Detecta cancelaciones explícitas en orderItems (no updates KDS sent→preparing→prepared/ready→served).
    function isCancellingOrderLine() {
      let before = resource.data;
      let after = request.resource.data;
      let diff = after.diff(before);
      let affected = diff.affectedKeys();

      let statusToCancelled = affected.hasAny(['status'])
        && isCancelledLineStatus(after.status)
        && !isCancelledLineStatus(before.status);

      let cancelledAtSet = affected.hasAny(['cancelledAt'])
        && after.cancelledAt is int
        && (!(before.cancelledAt is int) || before.cancelledAt == null);

      let beforeQty = orderItemLineQuantity(before);
      let afterQty = orderItemLineQuantity(after);
      let quantityToZero = (affected.hasAny(['quantity']) || affected.hasAny(['qty']))
        && afterQty is number
        && afterQty <= 0
        && (beforeQty == null || beforeQty > 0);

      return statusToCancelled || cancelledAtSet || quantityToZero;
    }

    function paymentUpdateTouchesRefundStatus() {
      let after = request.resource.data;
      let before = resource.data;
      let diff = after.diff(before);
      return diff.affectedKeys().hasAny(['status'])
        && after.status is string
        && (
          after.status.lower() == 'refunded'
          || after.status.lower() == 'refund'
          || after.status.lower() == 'devolucion'
          || after.status.lower() == 'cancelled'
          || after.status.lower() == 'canceled'
        )
        && (
          !(before.status is string)
          || before.status.lower() != after.status.lower()
        );
    }

    function paymentUpdateTouchesRefundFields() {
      let after = request.resource.data;
      let before = resource.data;
      let affected = after.diff(before).affectedKeys();
      return (affected.hasAny(['refundedAt'])
          && after.refundedAt is int
          && (!(before.refundedAt is int) || before.refundedAt == null))
        || (affected.hasAny(['refundAmount'])
          && after.refundAmount is number
          && after.refundAmount > 0)
        || (affected.hasAny(['finalTotal'])
          && after.finalTotal is number
          && before.finalTotal is number
          && after.finalTotal < before.finalTotal)
        || (affected.hasAny(['amount'])
          && after.amount is number
          && after.amount < 0)
        || (affected.hasAny(['type'])
          && after.type is string
          && after.type.lower() == 'refund')
        || (affected.hasAny(['paymentKind'])
          && after.paymentKind is string
          && after.paymentKind.lower() == 'refund')
        || (affected.hasAny(['refund'])
          && after.refund is bool
          && after.refund == true);
    }

    // Fase 5D: activo en payments update. Detecta refunds/anulaciones sin bloquear updates normales.
    function isRefundWrite() {
      return paymentUpdateTouchesRefundStatus() || paymentUpdateTouchesRefundFields();
    }

    // Fase 5D: wired en orders update; hoy siempre false (schema sin cancelledLineIds).
    // Cuando el TPV escriba cancelledLineIds al cancelar, exigirá canCancelTpvLine().
    // orders.items[] cancellation remains soft-protected by UI + orderItems rules until schema adds cancelledLineIds.
    function isCancellingOrderItemsArray() {
      let before = resource.data;
      let after = request.resource.data;
      let diff = after.diff(before);
      return diff.affectedKeys().hasAny(['items'])
        && after.keys().hasAny(['cancelledLineIds'])
        && (
          !(before.keys().hasAny(['cancelledLineIds']))
          || after.cancelledLineIds != before.cancelledLineIds
        );
    }

    function canManageSettings() {
      return isOwnerOrAdmin();
    }

    function canManageUsers() {
      return isOwnerOrAdmin();
    }

    function productCreateTouchesInventory() {
      return request.resource.data.keys().hasAny(['inventory']);
    }

    function productUpdateTouchesInventory() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventory']);
    }

    function profileHasRestaurant(profile, restaurantId) {
      return profile.restaurantId == restaurantId
        || (profile.restaurantIds is list && restaurantId in profile.restaurantIds)
        || (
          profile.restaurantIds is map
          && profile.restaurantIds.keys().hasAny([restaurantId])
        );
    }

    function sameRestaurant(resourceRestaurantId) {
      return isAuth()
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && profileHasRestaurant(
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
              resourceRestaurantId
            )
          )
          || (
            exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            && profileHasRestaurant(
              get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data,
              resourceRestaurantId
            )
          )
        );
    }

    // USERS
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Legacy user profile mirror used by older Hostly accounts.
    match /usuarios/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // PRODUCTS
    match /products/{productId} {
      allow read, write: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
    }

    // INVITES
    match /restaurant_invites/{inviteId} {
      allow read: if isAuth() && resource.data.email == request.auth.token.email;

      allow create: if isAuth()
        && request.resource.data.restaurantId == userRestaurantId();

      allow update: if isAuth()
        && resource.data.email == request.auth.token.email;

      allow delete: if false;
    }

    // Catálogo central por restaurante (ruta explícita; no inferir desde el doc padre).
    match /restaurants/{restaurantId}/products/{productId} {
      allow read: if sameRestaurant(restaurantId);

      allow create: if sameRestaurant(restaurantId)
        && (!productCreateTouchesInventory() || canManageInventory());

      allow update: if sameRestaurant(restaurantId)
        && (!productUpdateTouchesInventory() || canManageInventory());

      // Borrado definitivo: gestión de carta (manager+). Desactivar usa update (active/visibleOnMenu).
      allow delete: if sameRestaurant(restaurantId) && isManagerOrAbove();

      // Movimientos de stock por producto: append-only + capability inventario.
      match /stockMovements/{movementId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId) && canManageInventory();
      }
    }

    // Recepciones de inventario central (solo alta y lectura en fase 1).
    match /restaurants/{restaurantId}/inventoryReceipts/{receiptId} {
      allow read, create: if sameRestaurant(restaurantId);
    }

    // RESTAURANTS (doc del restaurante + subcolecciones distintas de products/)
    match /restaurants/{restaurantId} {
      // Primer restaurante en registro owner: aún no existe users/{uid} ni usuarios/{uid}.
      allow create: if isAuth()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['name', 'createdAt']);

      allow read: if sameRestaurant(restaurantId);
      allow update, delete: if sameRestaurant(restaurantId) && canManageSettings();

      // Config operacional / sensible por docId.
      // tableGroups: join/separar mesas (manager+). floorPlanLayouts/printers: settings (owner/admin).
      match /config/{groupDocId} {
        allow read: if (groupDocId == "tableGroups" || groupDocId == "floorPlanLayouts" || groupDocId == "printers")
          && sameRestaurant(restaurantId);
        allow create, update: if groupDocId == "tableGroups"
          && sameRestaurant(restaurantId)
          && isManagerOrAbove();
        allow create, update: if (groupDocId == "floorPlanLayouts" || groupDocId == "printers")
          && sameRestaurant(restaurantId)
          && canManageSettings();
        allow delete: if false;
      }

      match /inventoryProducts/{inventoryProductId} {
        allow read: if sameRestaurant(restaurantId);
        allow create, update, delete: if false;
      }

      match /floorPlanSnapshots/{snapshotId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Editor Sala V2 — borrador del mapa operativo.
      // El documento publicado queda reservado para una fase posterior.
      match /salaEditorMaps/{mapState} {
        allow read: if mapState == "draft"
          && sameRestaurant(restaurantId);
        allow create: if mapState == "draft"
          && sameRestaurant(restaurantId)
          && canManageSettings()
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.state == "draft";
        allow update: if mapState == "draft"
          && sameRestaurant(restaurantId)
          && canManageSettings()
          && resource.data.restaurantId == restaurantId
          && resource.data.state == "draft"
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.state == "draft";
        allow delete: if false;
      }

      // Borradores de importación de carta (IA / OCR — sin publicar productos).
      match /menuImportDrafts/{draftId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Estaciones operativas configurables (preparación / impresión por punto).
      match /operationStations/{stationId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Estaciones de producción (Configuración → Producción; sin cablear a KDS/TPV aún).
      match /productionStations/{stationId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Familias de producto (bebidas / comida / otros — agrupación de categorías).
      match /productFamilies/{familyId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Grupos de modificadores (formato bebida, mixer, extras — configuración TPV futura).
      match /modifierGroups/{groupId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Cola de tickets de impresión (simulador / worker futuro).
      match /printJobs/{jobId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Ledger central de movimientos (recepciones futuras, venta por modificador, etc.).
      match /stockMovements/{movementId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
      }

      // Borradores de pedido sugerido (compras inteligentes — sin envío a proveedor).
      match /purchaseDrafts/{draftId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      // Pedidos de compra internos (desde borrador — sin envío a proveedor).
      match /purchaseOrders/{purchaseOrderId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && canManagePurchases();
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && canManagePurchases();
        allow delete: if false;
      }

      // Recepciones operativas de pedidos de compra (ledger central).
      match /purchaseReceipts/{receiptId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && canManagePurchases();
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && canManagePurchases();
        allow delete: if false;
      }

      // Facturas de proveedor (coste real recibido — sin contabilidad ni pagos).
      match /supplierInvoices/{invoiceId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && canManageSupplierInvoices();
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && canManageSupplierInvoices();
        allow delete: if false;
      }

      // Aliases aprendidos OCR facturas proveedor → producto inventario.
      match /supplierProductAliases/{aliasId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId;
        allow delete: if false;
      }

      // Registro operacional append-only (trazabilidad multi-tablet).
      match /activityLogs/{logId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update, delete: if false;
      }

      // Presencia operacional soft-lock (multi-tablet awareness).
      match /tablePresence/{presenceId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId;
        allow delete: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId;
      }

      // Sesiones activas por dispositivo/pestaña (trazabilidad operacional).
      match /activeSessions/{sessionId} {
        allow read: if sameRestaurant(restaurantId);
        allow create: if sameRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow update: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId;
        allow delete: if sameRestaurant(restaurantId)
          && resource.data.restaurantId == restaurantId;
      }
    }

    // TABLES
    match /tables/{tableId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if false;
    }

    // FLOOR PLAN ZONES
    match /zones/{zoneId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if false;
    }

    // FLOOR PLANS
    match /floorPlans/{floorPlanId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if false;
    }

    // ORDERS — server-write-only (Admin SDK); lectura multi-tenant en cliente.
    match /orders/{orderId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ORDER ITEMS (líneas enviadas a cocina / KDS / cancel TPV)
    match /orderItems/{orderItemId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && (!isCancellingOrderLine() || canCancelTpvLine());
      allow delete: if false;
    }

    // RESERVATIONS
    match /reservations/{reservationId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId);
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if false;
    }

    // PAYMENTS (cobros, tickets, pagos parciales split_by_items)
    // Fase 5C: create → canChargeTpv(). Fase 5D: update refund/anulación → canRefundTpv().
    match /payments/{paymentId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId)
        && canChargeTpv();
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && (!isRefundWrite() || canRefundTpv());
      allow delete: if false;
    }

    // VOUCHERS (vales regalo — lookup TPV + saldo tras cobro)
    // Mismo tenant gate y capability de cobro que payments.
    match /vouchers/{voucherId} {
      allow read: if sameRestaurant(resource.data.restaurantId);
      allow create: if sameRestaurant(request.resource.data.restaurantId)
        && canChargeTpv();
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && canChargeTpv();
      allow delete: if false;
    }

    // BILLING CUSTOMERS (empresas reutilizables en facturación TPV)
    match /billingCustomers/{customerId} {
      allow read: if sameRestaurant(resource.data.restaurantId)
        && canChargeTpv();
      allow create: if sameRestaurant(request.resource.data.restaurantId)
        && canChargeTpv();
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && canChargeTpv();
      allow delete: if sameRestaurant(resource.data.restaurantId)
        && isManagerOrAbove();
    }

    // BILLING INVOICES (facturas emitidas desde TPV)
    match /billingInvoices/{invoiceId} {
      allow read: if sameRestaurant(resource.data.restaurantId)
        && canChargeTpv();
      allow create: if sameRestaurant(request.resource.data.restaurantId)
        && canChargeTpv();
      allow update: if sameRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && canChargeTpv();
      allow delete: if false;
    }

    match /billingInvoiceCounters/{restaurantId} {
      allow read: if sameRestaurant(restaurantId) && canChargeTpv();
      allow create, update: if sameRestaurant(restaurantId) && canChargeTpv();
      allow delete: if false;
    }

    match /billingInvoiceSettings/{restaurantId} {
      allow read: if sameRestaurant(restaurantId) && canChargeTpv();
      allow create, update: if sameRestaurant(restaurantId) && isManagerOrAbove();
      allow delete: if false;
    }
  }
}
