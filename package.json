{
  "name": "hostly-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:tpv-server": "firebase emulators:exec --only firestore --project demo-hostly-tpv-mutations \"tsx --test tests/server/tpv-mutations-emulator.test.ts\" && firebase emulators:exec --only firestore --project demo-hostly-tpv-table-lock \"tsx --test tests/server/tpv-table-order-lock-emulator.test.ts\" && firebase emulators:exec --only firestore --project demo-hostly-tpv-release-fx \"tsx --test tests/server/tpv-release-effects-emulator.test.ts\"",
    "test:tpv-unit": "tsx --test tests/server/tpv-mutations.test.ts tests/server/tpv-mutations-via-api.test.ts tests/server/sync-order-items-via-api.test.ts tests/server/tpv-table-order-lock.test.ts tests/carta/release-effects-exactly-once.test.ts tests/lib/back-to-map-pending-draft.test.ts tests/lib/recipe-stock-server.test.ts",
    "test:tpv-recipe-stock": "tsx --test tests/lib/recipe-stock-server.test.ts",
    "test:tpv-back-to-map": "tsx --test tests/lib/back-to-map-pending-draft.test.ts",
    "test:tpv-table-order-lock": "tsx --test tests/server/tpv-table-order-lock.test.ts",
    "test:tpv-table-order-lock-server": "firebase emulators:exec --only firestore --project demo-hostly-tpv-table-lock \"tsx --test tests/server/tpv-table-order-lock-emulator.test.ts\"",
    "test:tpv-release-effects": "tsx --test tests/carta/release-effects-exactly-once.test.ts",
    "test:tpv-release-effects-server": "firebase emulators:exec --only firestore --project demo-hostly-tpv-release-fx \"tsx --test tests/server/tpv-release-effects-emulator.test.ts\"",
    "eval:menu-import": "tsx scripts/eval-menu-import-corpus.ts",
    "eval:menu-import:v2": "tsx scripts/eval-menu-import-corpus.ts --shadow-v2 --skip-baseline-check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/vision": "^5.3.6",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.7.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
