{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "env": {
    "HOSTLY_AI_IMAGE_MODEL": "google/gemini-2.5-flash-image"
  },
  "crons": [
    {
      "path": "/api/cron/operational-alert-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/fiscal-outbox-recovery",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/queues/catalog-image-bulk/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "catalog-image-bulk" }
      ]
    },
    "app/api/queues/fiscal-aeat-submit/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "fiscal-aeat-submit" }
      ]
    }
  }
}
